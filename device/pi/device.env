# 電話機の設定。
# 本物のファイルは Pi の /etc/kazokuai/device.env にだけ置く。
# 合言葉と見守る方の ID は、人がそのファイルに書く。この見本の値は空である。

# バックエンドの URL。既定は手元のバックエンド。https のときは wss でつなぐ。
# Pi から届くアドレスに書き換える。
KAZOKUAI_BACKEND=http://localhost:8080

# 見守る方の ID。人が入れる。
KAZOKUAI_WATCHED_PERSON=

# 合言葉。人が入れる。空なら、手元の開発用の合言葉になる。
PHONE_SECRET=

# ここから下は、受話器、フック、呼び出し音の設定である。Linux の実行ファイルが読む。
# 値は既定である。音声の名前だけは、音声を開く前に人が書く。空だと開けない。

# USB オーディオの名前の一部。音声を開くときは要る。
KAZOKUAI_AUDIO_DEVICE=

# マイクのチャンネル。最初が 0。
KAZOKUAI_MIC_CHANNEL=0

# スピーカーの音に掛ける倍率。0 より大きく 4 以下。
KAZOKUAI_SPEAKER_GAIN=0.15

# フルスケールに対する上限。0 より大きく 1 以下。
KAZOKUAI_SPEAKER_LIMIT=0.1

# GPIO のチップ。
KAZOKUAI_GPIO_CHIP=gpiochip0

# フックの BCM 番号。
KAZOKUAI_HOOK_GPIO=5

# 呼び出し音の BCM 番号。
KAZOKUAI_RINGER_GPIO=18

# 上げると接点が閉じるなら true、開くなら false。
KAZOKUAI_LIFTED_WHEN_CLOSED=true

# フックが安定したとみなす時間。
KAZOKUAI_HOOK_DEBOUNCE=50ms
