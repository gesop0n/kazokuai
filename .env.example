# 値はリポジトリに置かない。.env は git に入らない。mise がタスクを実行するときに読む。

# 有料プランの Gemini の API キー。手元のバックエンドが読む。本番の Cloud Run は Secret Manager の gemini-api-key を読む。
GEMINI_API_KEY=

# 審査員用アカウント。demo:seed が読む。パスワードは 6 文字以上。
JUDGE_EMAIL=
JUDGE_PASSWORD=

# 電話機とバックエンドの合言葉。本番では Secret Manager の phone-shared-secret と同じ値にする。
PHONE_SECRET=
