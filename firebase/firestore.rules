rules_version = '2';

// アプリは家族としてログインして読む。書くのは、その家族が見たチュートリアルの記録だけ。
// ほかの書き込みはすべてバックエンドを通し、バックエンドのサーバーの SDK はこのルールに縛られない
service cloud.firestore {
  match /databases/{database}/documents {
    // 見守る方。familyUids は、その見守る方に結び付いた家族の uid の一覧である
    match /watchedPersons/{watchedPerson} {
      allow read: if request.auth != null && request.auth.uid in resource.data.familyUids;

      // 電話と、その会話。家族かどうかは電話に写さず、見守る方のドキュメントを get() で確かめる
      match /calls/{call} {
        allow read: if isFamily(watchedPerson);

        match /utterances/{utterance} {
          allow read: if isFamily(watchedPerson);
        }
      }
    }

    // 家族かどうかは、見守る方のドキュメントにある familyUids で決める
    function isFamily(watchedPerson) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/watchedPersons/$(watchedPerson)).data.familyUids;
    }

    // 使い方を見た記録。ドキュメント ID は家族の uid。自分の記録だけを読み書きできる
    match /tutorialSeen/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
