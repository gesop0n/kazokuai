#!/bin/bash
set -eu

QEMU=/usr/local/libexec/pisim/qemu-aarch64-gpio
BINFMT=/proc/sys/fs/binfmt_misc
ENTRY="$BINFMT/qemu-aarch64"

[ -e "$BINFMT/register" ] || mount -t binfmt_misc binfmt_misc "$BINFMT"

if [ -e "$ENTRY" ]; then
	grep -qx "interpreter $QEMU" "$ENTRY" && exit 0
	echo -1 >"$ENTRY"
fi

echo ":qemu-aarch64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xb7\x00:\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:$QEMU:POF" >"$BINFMT/register"
